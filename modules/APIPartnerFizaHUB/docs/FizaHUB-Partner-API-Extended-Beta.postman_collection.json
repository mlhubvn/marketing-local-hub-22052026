{
    "info": {
        "name": "MLHUB × FizaHUB Partner API - Extended Beta",
        "_postman_id": "b6f0f2a2-2a5e-4a44-9d9c-fizahubextbeta",
        "description": "14 endpoint MỞ RỘNG (Beta) — nằm ngoài 10 endpoint MVP đã thống nhất. Dùng bộ này SAU khi đã chạy xong FizaHUB-Partner-API-MVP-v1.postman_collection.json (cần onboarding_request_id/ticket_id/campaign_id thật lấy từ MVP hoặc từ chính bộ này).\n\nGồm: xác thực SSO nội bộ, catalog gói dịch vụ, xác nhận/huỷ onboarding thủ công, one-time login vào Portal MLHUB, insight/khuyến nghị tăng trưởng, danh sách & chi tiết chiến dịch QR, tổng hợp/danh sách ticket, gửi tin nhắn hỗ trợ, đóng/mở lại ticket.\n\nBảo mật: KHÔNG gửi CCCD/ảnh giấy tờ qua các API này. partner_token để trống hoặc thay bằng token thật do MLHUB cấp.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// from/to luôn là 30 ngày gần nhất tính theo ngày chạy request (không phải hạn mức gói).",
                    "function fmt(date) { return date.toISOString().slice(0, 10); }",
                    "const to = new Date();",
                    "const from = new Date();",
                    "from.setDate(from.getDate() - 30);",
                    "pm.collectionVariables.set('to', fmt(to));",
                    "pm.collectionVariables.set('from', fmt(from));"
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "https://mlhub.vn"
        },
        {
            "key": "partner_token",
            "value": "replace-with-token"
        },
        {
            "key": "external_business_id",
            "value": "fh-biz-demo-001"
        },
        {
            "key": "onboarding_request_id",
            "value": ""
        },
        {
            "key": "ticket_id",
            "value": ""
        },
        {
            "key": "campaign_id",
            "value": ""
        },
        {
            "key": "from",
            "value": ""
        },
        {
            "key": "to",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "1. POST SSO Verify",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Authorization", "value": "Bearer {{partner_token}}" },
                    { "key": "X-Partner", "value": "fizahub" },
                    { "key": "X-Request-Id", "value": "{{$guid}}" },
                    { "key": "Accept", "value": "application/json" },
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/partners/fizahub/partner/sso/verify",
                    "host": ["{{base_url}}"],
                    "path": ["api", "v1", "partners", "fizahub", "partner", "sso", "verify"]
                }
            },
            "response": [
                {
                    "name": "Thành công",
                    "status": "OK",
                    "code": 200,
                    "_postman_previewlanguage": "json",
                    "header": [{ "key": "Content-Type", "value": "application/json" }],
                    "body": "{\n  \"success\": true,\n  \"data\": { \"partner_code\": \"fizahub\", \"verified\": true },\n  \"error\": null\n}"
                }
            ]
        },
