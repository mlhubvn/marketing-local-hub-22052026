                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "if (pm.response.code === 200) {",
                            "    const campaigns = pm.response.json().data.campaigns || [];",
                            "    if (campaigns.length > 0 && campaigns[0].campaign_id) {",
                            "        pm.collectionVariables.set('campaign_id', campaigns[0].campaign_id);",
                            "    }",
                            "}"
                        ]
                    }
