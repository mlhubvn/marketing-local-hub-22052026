{
    "info": {
        "name": "MLHUB × FizaHUB Partner API - MVP v1",
        "_postman_id": "b6f0f2a2-2a5e-4a44-9d9c-fizahubmvp001",
        "description": "10 endpoint MVP đã thống nhất của tích hợp MLHUB × FizaHUB — đủ để chạy hết một vòng đời thật: onboarding → theo dõi trạng thái → liên kết doanh nghiệp → gói dịch vụ → dashboard → cập nhật hồ sơ → hỗ trợ (tạo ticket, xem hội thoại, gửi tệp đính kèm).\n\nLuồng đề xuất: 1) GET Health kiểm tra kết nối → 2) POST Onboarding (tự lưu data.request_id vào {{onboarding_request_id}}) → 3) GET Onboarding Status để theo dõi → 4) GET Integration Status / GET Business Package để xác nhận external_business_id đã được liên kết → 5) GET Dashboard xem số liệu tăng trưởng → 6) PATCH Update Business Profile khi cần sửa hồ sơ → 7) POST Create Support Ticket (tự lưu data.ticket_id) → 8) GET Support Ticket Detail để theo dõi hội thoại → 9) POST Upload Support Attachment khi cần gửi minh chứng.\n\nCác endpoint mở rộng (SSO verify, package catalog, confirm/cancel onboarding, one-time login, insights/recommendations, campaigns, support summary/list/message/close/reopen) nằm trong bộ FizaHUB-Partner-API-Extended-Beta.postman_collection.json riêng.\n\nBảo mật: KHÔNG gửi CCCD/ảnh giấy tờ qua các API này. partner_token để trống hoặc thay bằng token thật do MLHUB cấp — KHÔNG dùng lại token demo trong tài liệu.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// from/to luôn là 30 ngày gần nhất tính theo ngày chạy request (không phải hạn mức gói).",
                    "function fmt(date) { return date.toISOString().slice(0, 10); }",
                    "const to = new Date();",
                    "const from = new Date();",
                    "from.setDate(from.getDate() - 30);",
                    "pm.collectionVariables.set('to', fmt(to));",
                    "pm.collectionVariables.set('from', fmt(from));"
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "https://mlhub.vn"
        },
        {
            "key": "partner_token",
            "value": "replace-with-token"
        },
        {
            "key": "external_user_id",
            "value": "fh-user-demo-001"
        },
        {
            "key": "external_business_id",
            "value": "fh-biz-demo-001"
        },
        {
            "key": "onboarding_request_id",
            "value": ""
        },
        {
            "key": "ticket_id",
            "value": ""
        },
        {
            "key": "from",
            "value": ""
        },
        {
            "key": "to",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "1. GET Health",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{partner_token}}"
                    },
                    {
                        "key": "X-Partner",
                        "value": "fizahub"
                    },
                    {
                        "key": "X-Request-Id",
                        "value": "{{$guid}}"
                    },
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/partners/fizahub/health",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "partners",
                        "fizahub",
                        "health"
                    ]
                },
                "description": "Kiểm tra kết nối trước khi chạy các bước còn lại. Nếu trả 401/400 nghĩa là partner_token hoặc X-Partner/X-Request-Id header đang sai."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Trả về 200 khi header hợp lệ', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "pm.test('data.status = ok', function () {",
                            "    pm.expect(pm.response.json().data.status).to.eql('ok');",
                            "});"
                        ]
                    }
                }
            ],
            "response": [
                {
                    "name": "Thành công",
                    "status": "OK",
                    "code": 200,
                    "_postman_previewlanguage": "json",
                    "header": [{ "key": "Content-Type", "value": "application/json" }],
                    "body": "{\n  \"success\": true,\n  \"data\": { \"status\": \"ok\" },\n  \"meta\": { \"request_id\": \"{{$guid}}\" },\n  \"error\": null\n}"
                },
                {
                    "name": "Lỗi xác thực (token/X-Partner/X-Request-Id sai)",
                    "status": "Bad Request",
                    "code": 400,
                    "_postman_previewlanguage": "json",
                    "header": [{ "key": "Content-Type", "value": "application/json" }],
                    "body": "{\n  \"success\": false,\n  \"data\": null,\n  \"error\": { \"code\": \"invalid_partner_header\", \"message\": \"The X-Request-Id header must be a valid UUID.\", \"details\": [] }\n}"
                }
            ]
        },
