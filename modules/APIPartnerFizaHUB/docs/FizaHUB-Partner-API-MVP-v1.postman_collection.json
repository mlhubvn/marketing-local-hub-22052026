                "description": "MLHUB LUÔN tạo ngay tài khoản Free rồi đặt trạng thái awaiting_consultant. requested_package_code lưu riêng (base), package_code hiệu lực = free. Trùng email/mã số thuế/GPKD vẫn tạo tài khoản nhưng chuyển needs_review. Script Tests bên dưới tự lưu data.request_id vào biến {{onboarding_request_id}} để các request sau dùng ngay, không cần copy tay."
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Trả 201 kèm data.request_id thật (không phải fake id)', function () {",
                            "    pm.response.to.have.status(201);",
                            "    pm.expect(pm.response.json().data.request_id).to.be.a('string').and.not.empty;",
                            "});",
                            "if (pm.response.code === 201) {",
                            "    const data = pm.response.json().data;",
                            "    pm.collectionVariables.set('onboarding_request_id', data.request_id);",
                            "    if (data.external_business_id) {",
                            "        pm.collectionVariables.set('external_business_id', data.external_business_id);",
                            "    }",
                            "}"
                        ]
                    }
                }
            ],
            "response": [
                {
                    "name": "Thành công",
                    "status": "Created",
                    "code": 201,
                    "_postman_previewlanguage": "json",
                    "header": [{ "key": "Content-Type", "value": "application/json" }],
                    "body": "{\n  \"success\": true,\n  \"data\": {\n    \"request_id\": \"{{$guid}}\",\n    \"external_business_id\": \"{{external_business_id}}\",\n    \"account_created\": true,\n    \"business_created\": true,\n    \"integration_created\": true,\n    \"status\": \"awaiting_consultant\",\n    \"current_step\": \"consultant_contact\",\n    \"status_label\": \"Chờ tư vấn viên liên hệ\",\n    \"requested_package_code\": \"base\",\n    \"approved_package_code\": null,\n    \"package_code\": \"free\",\n    \"duplicate_check\": [],\n    \"mlhub_user_id\": 1001,\n    \"mlhub_business_id\": 2001\n  },\n  \"error\": null\n}"
