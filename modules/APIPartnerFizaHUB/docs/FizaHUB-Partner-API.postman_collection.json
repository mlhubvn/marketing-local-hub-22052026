          { "key": "X-Request-Id", "value": "{{$guid}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/partners/fizahub/businesses/{{external_business_id}}/package"
      }
    },
    {
      "name": "POST Onboarding",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('idempotency_key', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('onboarding response', function () {",
              "  const json = pm.response.json();",
              "  pm.expect([200, 201, 202]).to.include(pm.response.code);",
              "  pm.expect(json.success).to.eql(true);",
              "  if (json.data && json.data.request_id) {",
              "    pm.collectionVariables.set('onboarding_request_id', json.data.request_id);",
              "  }",
              "  if (json.data && json.data.external_business_id) {",
              "    pm.collectionVariables.set('external_business_id', json.data.external_business_id);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{partner_token}}" },
          { "key": "X-Partner", "value": "fizahub" },
          { "key": "X-Request-Id", "value": "{{$guid}}" },
          { "key": "Idempotency-Key", "value": "{{idempotency_key}}" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"external_business_id\": \"{{external_business_id}}\",\n  \"external_user_id\": \"{{external_user_id}}\",\n  \"package_code\": \"base\",\n  \"owner\": {\n    \"name\": \"Nguyen Van A\",\n    \"phone\": \"0901 234 567\",\n    \"email\": \"Owner.A@Example.com\"\n  },\n  \"business\": {\n    \"name\": \"Quan Com A\",\n    \"industry\": \"restaurant_food\",\n    \"phone\": \"0901-234-567\",\n    \"email\": \"shop@example.com\",\n    \"website\": \"https://shop.example.com\",\n    \"address\": \"Da Nang\",\n    \"tax_code\": \"0101-234-567\",\n    \"business_license_number\": \"GPKD 123\"\n  },\n  \"verification\": {\n    \"identity_verified\": true,\n    \"verified_at\": \"2026-07-13T10:00:00+07:00\",\n    \"verified_by\": \"fizahub\"\n  }\n}"
        },
