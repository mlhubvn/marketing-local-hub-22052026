            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_business_id\": \"{{external_business_id}}\",\n  \"external_user_id\": \"{{external_user_id}}\",\n  \"marketing_goal_codes\": [\"qr_checkin\", \"customer_retention\"],\n  \"package_code\": \"base\",\n  \"owner\": {\"name\": \"Đoàn Văn Khoa\", \"email\": \"fizahub.owner+{{external_business_id}}@example.com\"},\n  \"business\": {\"name\": \"Fiza Store\", \"industry\": \"restaurant_food\", \"phone\": \"0901234888\", \"email\": \"contact@fizastore.vn\", \"website\": \"https://fizastore.vn\", \"address\": \"888 Lê Duẩn, Đà Nẵng\"}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/partners/fizahub/onboarding-requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Onboarding accepted', () => pm.expect([200, 201, 202]).to.include(pm.response.code));",
                  "const onboardingData = pm.response.json().data || {};",
                  "pm.expect(onboardingData.request_id).to.be.a('string').and.not.empty;",
                  "pm.expect(onboardingData.username).to.match(/^[a-z0-9]+$/);",
                  "pm.collectionVariables.set('onboarding_request_id', onboardingData.request_id || '');",
                  "pm.collectionVariables.set('onboarding_ticket_id', onboardingData.support_ticket_id || '');",
                  "pm.collectionVariables.set('onboarding_ready', ['ready', 'completed'].includes(onboardingData.status) ? '1' : '0');"
                ]
              }
            }
          ]
        },
