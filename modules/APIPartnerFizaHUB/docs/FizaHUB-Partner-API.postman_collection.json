{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "FizaHUB Partner API (MLHUB MVP)",
    "description": "Ten MVP partner API requests for FizaHUB → MLHUB. Set base_url and partner_token. Support detail/message require external_business_id query.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost" },
    { "key": "partner_token", "value": "replace-with-fizahub-partner-token" },
    { "key": "external_user_id", "value": "fh-user-001" },
    { "key": "external_business_id", "value": "fh-biz-001" },
    { "key": "onboarding_request_id", "value": "" },
    { "key": "ticket_id", "value": "" },
    { "key": "from", "value": "2026-06-14" },
    { "key": "to", "value": "2026-07-13" }
  ],
  "item": [
    {
      "name": "GET Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('success shape', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data.status).to.eql('ok');",
              "  pm.expect(pm.response.headers.get('X-Request-Id')).to.be.ok;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{partner_token}}" },
          { "key": "X-Partner", "value": "fizahub" },
          { "key": "X-Request-Id", "value": "{{$guid}}" },
          { "key": "Accept", "value": "application/json" }
        ],
        "url": "{{base_url}}/api/v1/partners/fizahub/health"
      }
    },
    {
      "name": "GET Package",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('package whitelist shape', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.success).to.eql(true);",
              "  pm.expect(json.data).to.have.property('package_code');",
              "  pm.expect(json.data).to.have.property('limits');",
              "  pm.expect(json.data).to.not.have.property('price');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{partner_token}}" },
