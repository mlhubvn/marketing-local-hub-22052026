APP_NAME=MLHUB
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mlhub.vn
APP_INSTALLED=true

# --- MLHUB (Coolify) ---
# Deploy: push GitHub → Coolify redeploy → SSH container app:
#   php artisan mlhub:reset-demo --force
# Rồi Redis (ngoài container app): redis-cli -h $REDIS_HOST -p $REDIS_PORT -a "$REDIS_PASSWORD" FLUSHALL
# Đăng nhập: demo@mlhub.vn / 123456 — chi tiết: ARCHITECTURE_ADMINFAKER.md
MLHUB_ADMIN_PLAN_SLUG=agency-lifetime
# User chưa gán gói: bật hạn mức miễn phí (config/mlhub.php no_plan_access). Tắt = Inactive + Unlimited trên dashboard.
MLHUB_NO_PLAN_ACCESS_ENABLED=true
MLHUB_NO_PLAN_ACCESS_LABEL=None
MLHUB_NO_PLAN_CREDITS_LIMIT=100
MLHUB_NO_PLAN_MAX_BUSINESSES=1
MLHUB_NO_PLAN_MAX_CAMPAIGNS=3
MLHUB_NO_PLAN_MAX_LANDING_PAGES=3
MLHUB_NO_PLAN_MAX_QR_CODES=10
MLHUB_NO_PLAN_MAX_TEMPLATES=5
MLHUB_NO_PLAN_MAX_STORAGE_MB=512
MLHUB_ALLOW_RESET_DEMO=false
MLHUB_ADMIN_FAKER_USER=demo@mlhub.vn
MLHUB_LICENSE_PURCHASE_CODE=
MLHUB_LICENSE_PRODUCT_ID=10252026
MLHUB_LICENSE_VERSION=1.0.1
# Đổi khi deploy nếu user báo Livewire 419 sau khi nâng cấp (hoặc bảo họ Ctrl+F5)
LIVEWIRE_RELEASE_TOKEN=
MLHUB_LICENSE_INSTALL_PATH=./
MLHUB_LICENSE_DOMAIN=mlhub.vn
MLHUB_LICENSE_TYPE=Extended License
MLHUB_CONTACT_EMAIL=demo@mlhub.vn
# true = worker trong entrypoint.sh. Đặt false nếu Coolify đã chạy service queue riêng (tránh 2 worker).
RUN_QUEUE_WORKER=true
TRUSTED_PROXIES=*
APP_DEMO=false
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
DB_CONNECTION=mysql
DB_HOST=(API key đặt trong Coolify env)
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mysql
DB_PASSWORD=(API key đặt trong Coolify env)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=mlhub_session
SESSION_SECURE_COOKIE=true
# Production: .mlhub.vn (cookie dùng chung mlhub.vn + www). Local dev: để trống hoặc null.
SESSION_DOMAIN=.mlhub.vn
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=(Redis service hostname from Coolify — not committed)
REDIS_PASSWORD=(API key đặt trong Coolify env)
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.emailit.com
MAIL_PORT=587
MAIL_USERNAME=emailit
MAIL_PASSWORD=(API key đặt trong Coolify env)
MAIL_FROM_ADDRESS=noreply@mlhub.vn
MAIL_FROM_NAME=${APP_NAME}
MAIL_EHLO_DOMAIN=mlhub.vn
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
VITE_APP_NAME="${APP_NAME}"
APP_TIMEZONE=Asia/Ho_Chi_Minh
SITE_TITLE=MLHUB
SITE_DESCRIPTION=Nền tảng Marketing Automation hỗ trợ tăng đánh giá, đặt lịch, mã ưu đãi, phản hồi & tạo khách hàng tiềm năng.
SITE_KEYWORDS=MLHUB, Marketing Automation, đánh giá, đặt lịch, mã ưu đãi, phản hồi, khách hàng tiềm năng, hộ kinh doanh
THEME_FRONTEND=mlhubfrontend
THEME_BACKEND=mlhubbackend
GOOGLE_BUSINESS_CLIENT_ID=(API key đặt trong Coolify env)
GOOGLE_BUSINESS_CLIENT_SECRET=(API key đặt trong Coolify env)