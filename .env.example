# =============================================================================
# MLHUB — Mẫu biến môi trường (tài liệu tham chiếu cho Coolify Environment Variables)
# =============================================================================
# • Source of truth code: GitHub → Coolify auto build (docker-compose + env).
# • Giá trị thật (mật khẩu, API key): chỉ đặt tab Environment Variables của Coolify — KHÔNG commit .env.
# • Deploy thường: push GitHub → Coolify redeploy → entrypoint.sh tự chạy migrate + optimize.
# • Cài sạch (xóa toàn bộ DB): container app → php artisan mlhub:install
# • Cập nhật giữ dữ liệu: php artisan mlhub:update
#   Chi tiết: ARCHITECTURE_PROMPT.md §4.1 | Module: modules/CustomMLHUB/
# =============================================================================

# --- Laravel cốt lõi ---
APP_NAME=MLHUB
# production trên Coolify; local dev có thể dùng local
APP_ENV=production
# Sinh bằng: php artisan key:generate — bắt buộc, đặt secret trên Coolify
APP_KEY=(đặt secret trên Coolify — không commit)
# false trên production; true chỉ khi debug tạm trên staging
APP_DEBUG=false
# URL công khai HTTPS — dùng sinh link mail, redirect, Livewire (không hard-code http://)
APP_URL=https://mlhub.vn
# true = entrypoint.sh chạy migrate --force mỗi deploy. Luôn true trên Coolify (đã gỡ Web Installer)
APP_INSTALLED=true

# --- MLHUB: Super admin (module CustomMLHUB / mlhub:install | mlhub:update) ---
# Email đăng nhập super admin — tạo khi mlhub:install; mlhub:update không đổi mật khẩu user đã có
MLHUB_FIRST_USER_EMAIL=admin@mlhub.vn
# Mật khẩu mạnh — chỉ Coolify env, không ghi vào repo
MLHUB_FIRST_USER_PASSWORD=(mật khẩu mạnh — Coolify env)
# Tên hiển thị trong Admin/Portal
MLHUB_FIRST_USER_NAME=MLHUB Admin
# Username đăng nhập (slug, không dấu)
MLHUB_FIRST_USER_USERNAME=mlhubadmin
# Locale mặc định của super admin (vi = Tiếng Việt)
MLHUB_FIRST_USER_LOCALE=vi
# ID bắt đầu MySQL AUTO_INCREMENT sau seed (thương hiệu MLHUB — không đổi trừ khi có lý do)
MLHUB_STARTING_ID=147123468
# Slug gói gán cho super admin sau seed (vd agency-lifetime = full quyền)
MLHUB_ADMIN_PLAN_SLUG=agency-lifetime

# --- MLHUB: User đăng ký chưa gán gói (plan_id null) — dùng ngay miễn phí ---
# Mặc định: BẬT HẾT tính năng + addon, hạn mức thấp (đủ trải nghiệm 1 cửa hàng).
# Đổi false / giảm số bên dưới khi muốn showcase từng giai đoạn (ARCHITECTURE_FEATURE.md §1.1).
# MLHUB_NO_PLAN_ACCESS_ENABLED=false → chặn portal cho đến khi mua/gán gói.
# Sau đổi env Coolify: Redeploy hoặc user Ctrl+F5 dashboard.
MLHUB_NO_PLAN_ACCESS_ENABLED=true
MLHUB_NO_PLAN_ACCESS_LABEL=Free

# A. Credits AI
MLHUB_NO_PLAN_CREDITS_USAGE=true
MLHUB_NO_PLAN_CREDITS_LIMIT=100

# B. LocalBoost AI — growth (Review, Booking, Coupon, Feedback, Lead, QR, Landing, Reports)
MLHUB_NO_PLAN_LOCALBOOST=true
MLHUB_NO_PLAN_MAX_BUSINESSES=1
MLHUB_NO_PLAN_MAX_CAMPAIGNS=5
MLHUB_NO_PLAN_MAX_LANDING_PAGES=5
MLHUB_NO_PLAN_MAX_QR_CODES=15
MLHUB_NO_PLAN_MAX_TEMPLATES=5
MLHUB_NO_PLAN_REMOVE_BRANDING=false

# C. Files / Media library
MLHUB_NO_PLAN_FILES=true
MLHUB_NO_PLAN_MAX_STORAGE_MB=512
MLHUB_NO_PLAN_MAX_FILE_SIZE_MB=32
MLHUB_NO_PLAN_IMAGE_EDITOR=true
MLHUB_NO_PLAN_SEARCH_MEDIA_ONLINE=true
MLHUB_NO_PLAN_FILE_GOOGLE_DRIVE=true
MLHUB_NO_PLAN_FILE_DROPBOX=true
MLHUB_NO_PLAN_FILE_ONEDRIVE=true

# D. Support tickets + Affiliate
MLHUB_NO_PLAN_SUPPORT=true
MLHUB_NO_PLAN_AFFILIATE=true

# E. AI Studio — bật hết công cụ con (credit vẫn trừ theo MLHUB_NO_PLAN_CREDITS_LIMIT)
MLHUB_NO_PLAN_AI_STUDIO=true
MLHUB_NO_PLAN_AI_CAPTION=true
MLHUB_NO_PLAN_AI_CONTENT_PLANNER=true
MLHUB_NO_PLAN_AI_REPURPOSE=true
MLHUB_NO_PLAN_AI_IMAGE=true

# F. Teams
MLHUB_NO_PLAN_TEAMS=true
MLHUB_NO_PLAN_MAX_TEAM_MEMBERS=2

# G. Addon: Advanced Customer CRM
MLHUB_NO_PLAN_ADVANCED_CRM=true
MLHUB_NO_PLAN_CRM_TAGS=10
MLHUB_NO_PLAN_CRM_SEGMENTS=3
MLHUB_NO_PLAN_CRM_TASKS=20
MLHUB_NO_PLAN_CRM_AUTOMATIONS=2
MLHUB_NO_PLAN_CRM_RETENTION_DAYS=90

# H. Addon: Google Business Profile (chỉ gói Free / user chưa gán gói — gói trả phí dùng max_businesses)
MLHUB_NO_PLAN_GOOGLE_BUSINESS=true
MLHUB_NO_PLAN_GOOGLE_CONNECTIONS=1
MLHUB_NO_PLAN_GOOGLE_LOCATIONS=1
MLHUB_NO_PLAN_GOOGLE_REVIEW_SYNC=true
MLHUB_NO_PLAN_GOOGLE_REVIEW_REPLY=true
MLHUB_NO_PLAN_GOOGLE_INSIGHTS=true
MLHUB_NO_PLAN_GOOGLE_POSTS=true

# I. Addon: Email Automation
MLHUB_NO_PLAN_EMAIL_AUTOMATION=true
MLHUB_NO_PLAN_MAX_EMAIL_AUTOMATIONS=2
MLHUB_NO_PLAN_MAX_EMAIL_TEMPLATES=3
MLHUB_NO_PLAN_EMAILS_PER_MONTH=200
MLHUB_NO_PLAN_EMAIL_DELAY=true
MLHUB_NO_PLAN_EMAIL_CONDITIONS=true

# J. Addon: WhatsApp Notification
MLHUB_NO_PLAN_WHATSAPP=true
MLHUB_NO_PLAN_MAX_WHATSAPP_RULES=2
MLHUB_NO_PLAN_MAX_WHATSAPP_TEMPLATES=2
MLHUB_NO_PLAN_WHATSAPP_MESSAGES_PER_MONTH=50
MLHUB_NO_PLAN_WHATSAPP_CLOUD_API=true
MLHUB_NO_PLAN_WHATSAPP_TEMPLATE_MSG=true

# K. Addon: Webhook & Zapier
MLHUB_NO_PLAN_WEBHOOK=true
MLHUB_NO_PLAN_MAX_WEBHOOK_RULES=2
MLHUB_NO_PLAN_WEBHOOKS_PER_MONTH=300
MLHUB_NO_PLAN_WEBHOOK_HEADERS=true
MLHUB_NO_PLAN_WEBHOOK_RETRY=true

# L. Addon: Loyalty & Referral
MLHUB_NO_PLAN_LOYALTY=true
MLHUB_NO_PLAN_MAX_LOYALTY_CARDS=1
MLHUB_NO_PLAN_MAX_LOYALTY_CUSTOMERS=100
MLHUB_NO_PLAN_MAX_REFERRAL_CAMPAIGNS=1
MLHUB_NO_PLAN_LOYALTY_REWARDS=true
MLHUB_NO_PLAN_LOYALTY_STAFF_REDEEM=true

# M. Addon: Custom Domains (QR / brand)
MLHUB_NO_PLAN_CUSTOM_DOMAINS=true
MLHUB_NO_PLAN_MAX_CUSTOM_DOMAINS=1

# --- MLHUB: Bảo vệ production ---
# false = chặn db:wipe / migrate:fresh trên production (AppServiceProvider). Luôn false khi có dữ liệu thật
MLHUB_ALLOW_RESET_DEMO=false

# --- MLHUB: License Stackposts (marketplace + addon) ---
# Mã purchase từ Stackposts — seed ghi vào options.license_* khi có giá trị
MLHUB_LICENSE_PURCHASE_CODE=(mã license Stackposts — Coolify env)
MLHUB_LICENSE_PRODUCT_ID=10252026
MLHUB_LICENSE_VERSION=1.0.1
MLHUB_LICENSE_INSTALL_PATH=./
MLHUB_LICENSE_DOMAIN=mlhub.vn
MLHUB_LICENSE_TYPE=Extended License

# Email liên hệ site (Admin → Cài đặt) — thường trùng MLHUB_FIRST_USER_EMAIL
MLHUB_CONTACT_EMAIL=admin@mlhub.vn

# --- Livewire (cache-bust JS sau deploy lớn) ---
# Đổi chuỗi bất kỳ khi user báo 419 "page expired" sau nâng cấp; hoặc bảo họ Ctrl+F5
LIVEWIRE_RELEASE_TOKEN=

# --- Queue worker trong container ---
# true = entrypoint.sh chạy queue:work nền. false nếu Coolify đã có service queue riêng (tránh 2 worker)
RUN_QUEUE_WORKER=true

# --- Proxy / Demo ---
# * = tin mọi proxy (Coolify/Traefik) — HTTPS được nhận đúng trong bootstrap/app.php
TRUSTED_PROXIES=*
# false = production thật; true chỉ chặn ghi HTTP/Livewire (demo showcase)
APP_DEMO=false

# --- Ngôn ngữ & múi giờ ---
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
# Locale Faker khi seed/test (địa chỉ VN)
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Log & bảo mật ---
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# error trên production — giảm noise log
LOG_LEVEL=error

# --- MySQL (Coolify service nội bộ) ---
DB_CONNECTION=mysql
DB_HOST=(hostname MySQL từ Coolify — không commit)
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mysql
DB_PASSWORD=(mật khẩu MySQL — Coolify env)

# --- Session (Redis — bắt buộc production) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=mlhub_session
SESSION_SECURE_COOKIE=true
# .mlhub.vn = cookie dùng chung mlhub.vn + www. Local dev: để trống
SESSION_DOMAIN=.mlhub.vn

# --- Queue & Cache (Redis) ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
# Internal Hostname từ tab Redis trên Coolify (đổi mỗi khi tạo lại Redis — lỗi getaddrinfo = hostname cũ)
REDIS_HOST=(hostname Redis service Coolify — không commit)
# Chỉ mật khẩu, KHÔNG gõ REDIS_PASSWORD=REDIS_PASSWORD=...
REDIS_PASSWORD=(mật khẩu Redis — Coolify env)
REDIS_PORT=6379

# --- Mail SMTP (Emailit) ---
# MAIL_PASSWORD seed vào options.smtp_password khi chạy mlhub:install / db:seed
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.emailit.com
MAIL_PORT=587
MAIL_USERNAME=emailit
MAIL_PASSWORD=(API key Emailit — Coolify env)
MAIL_FROM_ADDRESS=noreply@mlhub.vn
MAIL_FROM_NAME=${APP_NAME}
MAIL_EHLO_DOMAIN=mlhub.vn

# --- AWS S3 (tùy chọn — để trống = dùng disk public) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Wasabi S3 (tùy chọn — Admin có thể cấu hình storage sau) ---
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_DEFAULT_REGION=us-east-1
WASABI_BUCKET=
WASABI_URL=
WASABI_ENDPOINT=
WASABI_USE_PATH_STYLE_ENDPOINT=false

# --- Frontend build (Vite theme) ---
VITE_APP_NAME="${APP_NAME}"

# --- Site & theme MLHUB (seed → options + config/mlhub.php) ---
SITE_TITLE=MLHUB
SITE_DESCRIPTION=Nền tảng Marketing Automation hỗ trợ tăng đánh giá, đặt lịch, mã ưu đãi, phản hồi & tạo khách hàng tiềm năng.
SITE_KEYWORDS=MLHUB, Marketing Automation, đánh giá, đặt lịch, mã ưu đãi, phản hồi, khách hàng tiềm năng, hộ kinh doanh
THEME_FRONTEND=mlhubfrontend
THEME_BACKEND=mlhubbackend

# --- Admin Settings ↔ Coolify (đồng bộ vào options mỗi deploy / mlhub:install / mlhub:update) ---
# true = ghi env có giá trị vào Admin → Cài đặt (khuyến nghị production). false = chỉ seed thủ công.
# Map chi tiết: modules/CustomMLHUB/config/env_options.php — chạy: php artisan mlhub:sync-env-options
MLHUB_SYNC_ENV_OPTIONS=true
# Cron URL bảo mật — giữ cố định để link cron không đổi sau mlhub:install (sinh ngẫu nhiên nếu để trống lần đầu)
MLHUB_SYSTEM_CRON_SECURE_KEY=
# Liên hệ site (Admin → General)
MLHUB_CONTACT_PHONE=0899789225
MLHUB_CONTACT_WEBSITE=https://mlhub.vn
MLHUB_CONTACT_LOCATION=01 Nguyễn Văn Linh, Đà Nẵng
MLHUB_CONTACT_WORKING_HOURS=Thứ 2 - Thứ 6: 09:00 - 18:00

# --- Google OAuth: 2 BỘ KEY RIÊNG (KHÔNG dùng chung, KHÔNG copy lẫn nhau) ---
# Bộ 1 — Google đăng nhập (Admin → Authentication Rules → Google login)
#   Env: MLHUB_AUTH_GOOGLE_LOGIN_*
#   Callback: https://mlhub.vn/auth/login/google/callback
#   Scope: openid email profile
# Bộ 2 — Google Business Profile (Admin → API Integration → Google Business Profile)
#   Env: GOOGLE_BUSINESS_CLIENT_* + MLHUB_GOOGLE_BUSINESS_STATUS
#   Callback: https://mlhub.vn/portal/integrations/google-business/callback
#   Scope: https://www.googleapis.com/auth/business.manage
# Tạo 2 OAuth Client ID riêng trên Google Cloud Console, mỗi client chỉ 1 redirect URI tương ứng.

# --- Admin → Authentication Rules (/admin/settings/auth) ---
# 1 = bật | 0 = tắt. Nếu không đặt MLHUB_AUTH_*_LOGIN_STATUS mà đã có ID + Secret → tự bật khi sync.
MLHUB_AUTH_LANDING_PAGE_STATUS=1
MLHUB_AUTH_SIGNUP_PAGE_STATUS=1
MLHUB_AUTH_ACTIVATION_EMAIL_STATUS=1
MLHUB_AUTH_WELCOME_EMAIL_STATUS=1
MLHUB_AUTH_USER_CHANGE_EMAIL_STATUS=0
MLHUB_AUTH_USER_CHANGE_USERNAME_STATUS=0
MLHUB_AUTH_TWO_FACTOR_STATUS=1
# [Bộ 1] Google đăng nhập — KHÔNG trùng GOOGLE_BUSINESS_CLIENT_*
MLHUB_AUTH_GOOGLE_LOGIN_STATUS=1
MLHUB_AUTH_GOOGLE_LOGIN_CLIENT_ID=(OAuth Client ID bộ 1 — đăng nhập Google — Coolify env)
MLHUB_AUTH_GOOGLE_LOGIN_CLIENT_SECRET=(OAuth Client Secret bộ 1 — đăng nhập Google — Coolify env)
# Facebook login — callback: https://mlhub.vn/auth/login/facebook/callback
MLHUB_AUTH_FACEBOOK_LOGIN_STATUS=0
MLHUB_AUTH_FACEBOOK_LOGIN_APP_ID=
MLHUB_AUTH_FACEBOOK_LOGIN_APP_SECRET=
MLHUB_AUTH_FACEBOOK_LOGIN_APP_VERSION=v22.0
# X (Twitter) login — callback: https://mlhub.vn/auth/login/x/callback
MLHUB_AUTH_X_LOGIN_STATUS=0
MLHUB_AUTH_X_LOGIN_CLIENT_ID=
MLHUB_AUTH_X_LOGIN_CLIENT_SECRET=

# --- Admin → Captcha (/admin/settings/captcha) ---
# Loại captcha: disable | turnstile | recaptcha
MLHUB_CAPTCHA_TYPE=turnstile
MLHUB_CLOUDFLARE_TURNSTILE_STATUS=1
MLHUB_CLOUDFLARE_TURNSTILE_SITE_KEY=(Cloudflare Turnstile site key — Coolify env)
MLHUB_CLOUDFLARE_TURNSTILE_SECRET_KEY=(Cloudflare Turnstile secret — Coolify env)
MLHUB_GOOGLE_RECAPTCHA_STATUS=0
MLHUB_GOOGLE_RECAPTCHA_SITE_KEY=
MLHUB_GOOGLE_RECAPTCHA_SECRET_KEY=

# --- Admin → Analytics (/admin/settings/analytics) ---
MLHUB_GOOGLE_ANALYTICS_STATUS=1
MLHUB_GOOGLE_ANALYTICS_MEASUREMENT_ID=G-ZY1P6YJLME
MLHUB_GOOGLE_ANALYTICS_TRACK_GUEST=1
MLHUB_GOOGLE_ANALYTICS_TRACK_APP=1

# --- Admin → API Integration → Google Business Profile ---
# [Bộ 2] Google Business — KHÔNG trùng MLHUB_AUTH_GOOGLE_LOGIN_*
MLHUB_GOOGLE_BUSINESS_STATUS=1
GOOGLE_BUSINESS_CLIENT_ID=(OAuth Client ID bộ 2 — Google Business Profile — Coolify env)
GOOGLE_BUSINESS_CLIENT_SECRET=(OAuth Client Secret bộ 2 — Google Business Profile — Coolify env)

# --- Admin → Payment → Stripe ---
STRIPE_STATUS=0
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
