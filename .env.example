# =============================================================================
# MLHUB — Biến môi trường (GIAI ĐOẠN THỬ NGHIỆM: điền sẵn giá trị thật để đối tác test)
# =============================================================================
# ⚠️ CHÍNH SÁCH THỬ NGHIỆM (theo yêu cầu chủ dự án — xem .cursorrules §8):
#   • File này ĐANG chứa giá trị thật (mật khẩu/secret) để tránh để trống gây tưởng lỗi
#     và để dev đối tác test đầy đủ. TRƯỚC KHI CHẠY CHÍNH THỨC: đổi toàn bộ secret + cân
#     nhắc để repo private. Secret trong git history không thể xóa hoàn toàn.
#   • Phần lớn giá trị đã có DEFAULT trong code (config/*.php, NoPlanAccess, env_options.php),
#     nên Coolify Environment Variables chỉ CẦN đặt vài biến hạ tầng riêng theo server:
#       APP_KEY, APP_URL, DB_HOST, DB_PASSWORD, REDIS_HOST, REDIS_PASSWORD.
#     Các biến còn lại có thể BỎ khỏi Coolify (code tự dùng default) → giảm tải, vào nhanh hơn.
#   • NGOẠI LỆ: FIZAHUB_PARTNER_TOKEN BẮT BUỘC đặt trên Coolify đúng giá trị trong file này —
#     giá trị này đã được đồng bộ vào file Postman đang gửi cho FizaHUB test, KHÔNG còn khớp
#     default 'fizahub' trong code nữa. Thiếu biến này → đối tác gọi API sẽ bị 401.
#   • MLHUB_NO_PLAN_* (mục A–M) đã trùng default trong app/Support/Plans/NoPlanAccess.php →
#     có thể xóa hết khỏi Coolify mà hành vi không đổi.
# -----------------------------------------------------------------------------
# • Source of truth code: GitHub → Coolify auto build (docker-compose + env).
# • Deploy thường: push GitHub → Coolify redeploy → docker/entrypoint.sh tự chạy migrate + optimize + mlhub:sync-env-options.
# • Cài sạch (xóa toàn bộ DB): container app → php artisan mlhub:install
# • Cập nhật giữ dữ liệu: php artisan mlhub:update
#   Chi tiết: ARCHITECTURE_PROMPT.md §4.1 | Module: modules/CustomMLHUB/
# =============================================================================

# =============================================================================
# ✅ BỘ TỐI THIỂU CẦN ĐẶT TRÊN COOLIFY (copy 6 dòng dưới, thay bằng giá trị server)
# =============================================================================
# 5 biến hạ tầng (APP_KEY/DB/REDIS) BẮT BUỘC vì không thể có default an toàn trong code.
# FIZAHUB_PARTNER_TOKEN cũng BẮT BUỘC ở giai đoạn đang cấp API cho FizaHUB test (xem cảnh báo
# ở trên) — giữ đúng giá trị đã đồng bộ với file Postman, đừng để trống/dùng default.
# Tất cả biến còn lại bên dưới ĐÃ CÓ DEFAULT trong code → có thể BỎ khỏi Coolify cho nhẹ:
#   - APP_ENV mặc định 'production' | APP_URL mặc định 'https://mlhub.vn' (config/app.php)
#   - DB_CONNECTION=mysql, DB_DATABASE=default, DB_USERNAME=mysql, REDIS_USERNAME=default (config/database.php)
#   - SESSION_DRIVER/QUEUE_CONNECTION/CACHE_STORE=redis, FILESYSTEM_DISK=public
#   - SESSION_DOMAIN=.mlhub.vn + SESSION_SECURE_COOKIE=true (tự bật khi APP_ENV=production)
#   - MLHUB_NO_PLAN_* (mục A–M) trùng default NoPlanAccess.php
#   - mail/captcha/auth/analytics/GBP/license: default trong env_options.php
#   - FIZAHUB_* khác (webhook/rate limit/package/ttl): default trong modules/APIPartnerFizaHUB/config/config.php
#
# APP_KEY=base64:ZsLIT5SiyQFlitofPwZS+/qfEjyOIVDwYOiZXHPrcIA=
# DB_HOST=vdd0voqmyudditvwfhuscrta
# DB_PASSWORD=FXlAITZo3hgZYZJ26pdHSn7e70Zm6EAh0uUTgNfUJgEScn6x24YiwAe9x89gmgIo
# REDIS_HOST=w13teqa9fusj56ddpl8w8ezf
# REDIS_PASSWORD=VJj4BYh0Oedesmer0LWeyeN8tfSQKuwBos9JfHamP375e9rAxYoWk40R4HLWPGlh
# FIZAHUB_PARTNER_TOKEN=fizahub_6199e9a82d0e961002965d406c970efc0038d2a4e658c1cf
#
# (Tùy chọn khuyến nghị đặt trên Coolify: APP_URL nếu khác mlhub.vn; RUN_QUEUE_WORKER=true.)
# ⚠️ Đổi toàn bộ secret trước khi chạy chính thức.
# =============================================================================

# --- Laravel cốt lõi ---
APP_NAME=MKT
# production trên Coolify; local dev có thể dùng local
APP_ENV=production
# Sinh bằng: php artisan key:generate — BẮT BUỘC đặt riêng trên Coolify cho từng môi trường.
# Giá trị thử nghiệm hiện tại (đổi trước khi chạy chính thức):
APP_KEY=base64:ZsLIT5SiyQFlitofPwZS+/qfEjyOIVDwYOiZXHPrcIA=
# false trên production; true chỉ khi debug tạm trên staging
APP_DEBUG=false
# URL công khai HTTPS — dùng sinh link mail, redirect, Livewire (không hard-code http://)
APP_URL=https://mlhub.vn
# true = docker/entrypoint.sh chạy migrate --force mỗi deploy. Luôn true trên Coolify (đã gỡ Web Installer)
APP_INSTALLED=true

# --- MLHUB: Super admin (module CustomMLHUB / mlhub:install | mlhub:update) ---
# Email đăng nhập super admin — tạo khi mlhub:install; mlhub:update không đổi mật khẩu user đã có
MLHUB_FIRST_USER_EMAIL=admin@mlhub.vn
# Mật khẩu super admin (giá trị thử nghiệm — đổi trước khi chạy chính thức)
MLHUB_FIRST_USER_PASSWORD=98Fb1288@@dvk192
# Tên hiển thị trong Admin/Portal
MLHUB_FIRST_USER_NAME=MKT Admin
# Username đăng nhập (slug, không dấu)
MLHUB_FIRST_USER_USERNAME=mlhubadmin
# Locale mặc định của super admin (vi = Tiếng Việt)
MLHUB_FIRST_USER_LOCALE=vi
# ID bắt đầu MySQL AUTO_INCREMENT sau seed (thương hiệu MLHUB — không đổi trừ khi có lý do)
MLHUB_STARTING_ID=147123468
# Slug gói gán cho super admin sau seed (MKT Partner Lifetime = full quyền)
MLHUB_ADMIN_PLAN_SLUG=mlhub-partner-lifetime

# --- MLHUB: Fallback cho user legacy/manual chưa gán gói (plan_id null) ---
# User đăng ký mới được tự động gán gói MKT Free Đà Nẵng mặc định.
# Mặc định: BẬT HẾT tính năng + addon, hạn mức thấp (đủ trải nghiệm 1 cửa hàng).
# Đổi false / giảm số bên dưới khi muốn showcase từng giai đoạn (ARCHITECTURE_FEATURE.md §1.1).
# MLHUB_NO_PLAN_ACCESS_ENABLED=false → chặn portal cho đến khi mua/gán gói.
# Sau đổi env Coolify: Redeploy hoặc user Ctrl+F5 dashboard.
MLHUB_NO_PLAN_ACCESS_ENABLED=true
MLHUB_NO_PLAN_ACCESS_LABEL=Free

# A. Credits AI
MLHUB_NO_PLAN_CREDITS_USAGE=true
MLHUB_NO_PLAN_CREDITS_LIMIT=100

# B. MKT AI — growth (Review, Booking, Coupon, Feedback, Lead, QR, Landing, Reports)
MLHUB_NO_PLAN_MLHUB=true
MLHUB_NO_PLAN_LOCALBOOST=true
MLHUB_NO_PLAN_MAX_BUSINESSES=1
MLHUB_NO_PLAN_MAX_CAMPAIGNS=5
MLHUB_NO_PLAN_MAX_LANDING_PAGES=5
MLHUB_NO_PLAN_MAX_QR_CODES=15
MLHUB_NO_PLAN_MAX_TEMPLATES=5
MLHUB_NO_PLAN_REMOVE_BRANDING=false

# C. Files / Media library
MLHUB_NO_PLAN_FILES=true
MLHUB_NO_PLAN_MAX_STORAGE_MB=512
MLHUB_NO_PLAN_MAX_FILE_SIZE_MB=32
MLHUB_NO_PLAN_IMAGE_EDITOR=true
MLHUB_NO_PLAN_SEARCH_MEDIA_ONLINE=true
MLHUB_NO_PLAN_FILE_GOOGLE_DRIVE=true
MLHUB_NO_PLAN_FILE_DROPBOX=true
MLHUB_NO_PLAN_FILE_ONEDRIVE=true

# D. Support tickets + Affiliate
MLHUB_NO_PLAN_SUPPORT=true
MLHUB_NO_PLAN_AFFILIATE=true

# E. AI Studio — bật hết công cụ con (credit vẫn trừ theo MLHUB_NO_PLAN_CREDITS_LIMIT)
MLHUB_NO_PLAN_AI_STUDIO=true
MLHUB_NO_PLAN_AI_CAPTION=true
MLHUB_NO_PLAN_AI_CONTENT_PLANNER=true
MLHUB_NO_PLAN_AI_REPURPOSE=true
MLHUB_NO_PLAN_AI_IMAGE=true

# F. Teams
MLHUB_NO_PLAN_TEAMS=true
MLHUB_NO_PLAN_MAX_TEAM_MEMBERS=2

# G. Addon: Advanced Customer CRM
MLHUB_NO_PLAN_ADVANCED_CRM=true
MLHUB_NO_PLAN_CRM_TAGS=10
MLHUB_NO_PLAN_CRM_SEGMENTS=3
MLHUB_NO_PLAN_CRM_TASKS=20
MLHUB_NO_PLAN_CRM_AUTOMATIONS=2
MLHUB_NO_PLAN_CRM_RETENTION_DAYS=90

# H. Addon: Google Business Profile (chỉ gói Free / user chưa gán gói — gói trả phí dùng max_businesses)
MLHUB_NO_PLAN_GOOGLE_BUSINESS=true
MLHUB_NO_PLAN_GOOGLE_CONNECTIONS=1
MLHUB_NO_PLAN_GOOGLE_LOCATIONS=1
MLHUB_NO_PLAN_GOOGLE_REVIEW_SYNC=true
MLHUB_NO_PLAN_GOOGLE_REVIEW_REPLY=true
MLHUB_NO_PLAN_GOOGLE_INSIGHTS=true
MLHUB_NO_PLAN_GOOGLE_POSTS=true

# I. Addon: Email Automation
MLHUB_NO_PLAN_EMAIL_AUTOMATION=true
MLHUB_NO_PLAN_MAX_EMAIL_AUTOMATIONS=2
MLHUB_NO_PLAN_MAX_EMAIL_TEMPLATES=3
MLHUB_NO_PLAN_EMAILS_PER_MONTH=200
MLHUB_NO_PLAN_EMAIL_DELAY=true
MLHUB_NO_PLAN_EMAIL_CONDITIONS=true

# J. Addon: WhatsApp Notification
MLHUB_NO_PLAN_WHATSAPP=true
MLHUB_NO_PLAN_MAX_WHATSAPP_RULES=2
MLHUB_NO_PLAN_MAX_WHATSAPP_TEMPLATES=2
MLHUB_NO_PLAN_WHATSAPP_MESSAGES_PER_MONTH=50
MLHUB_NO_PLAN_WHATSAPP_CLOUD_API=true
MLHUB_NO_PLAN_WHATSAPP_TEMPLATE_MSG=true

# K. Addon: Webhook & Zapier
MLHUB_NO_PLAN_WEBHOOK=true
MLHUB_NO_PLAN_MAX_WEBHOOK_RULES=2
MLHUB_NO_PLAN_WEBHOOKS_PER_MONTH=300
MLHUB_NO_PLAN_WEBHOOK_HEADERS=true
MLHUB_NO_PLAN_WEBHOOK_RETRY=true

# L. Addon: Loyalty & Referral
MLHUB_NO_PLAN_LOYALTY=true
MLHUB_NO_PLAN_MAX_LOYALTY_CARDS=1
MLHUB_NO_PLAN_MAX_LOYALTY_CUSTOMERS=100
MLHUB_NO_PLAN_MAX_REFERRAL_CAMPAIGNS=1
MLHUB_NO_PLAN_LOYALTY_REWARDS=true
MLHUB_NO_PLAN_LOYALTY_STAFF_REDEEM=true

# M. Addon: Custom Domains (QR / brand)
MLHUB_NO_PLAN_CUSTOM_DOMAINS=true
MLHUB_NO_PLAN_MAX_CUSTOM_DOMAINS=1

# --- MLHUB: Bảo vệ production ---
# false = chặn db:wipe / migrate:fresh trên production (AppServiceProvider).
# ⚠️ Đang để true cho GIAI ĐOẠN THỬ NGHIỆM (cho phép reset DB). ĐỔI VỀ false ngay khi có dữ liệu thật.
MLHUB_ALLOW_RESET_DEMO=true
# Chế độ seed dữ liệu mẫu khi mlhub:install/db:seed: full = đầy đủ demo | minimal = tối thiểu | none = không seed mẫu
MLHUB_SEEDING_MODE=full

# --- MLHUB: License Stackposts (marketplace + addon) ---
# Mã purchase từ Stackposts — seed ghi vào options.license_* khi có giá trị.
# Có DEFAULT trong config/mlhub.php nên có thể bỏ khỏi Coolify (giá trị thử nghiệm):
MLHUB_LICENSE_PURCHASE_CODE=d80177d1-4974-4e46-a7f3-564da3bc83f7
MLHUB_LICENSE_PRODUCT_ID=10252026
MLHUB_LICENSE_VERSION=1.0.1
MLHUB_LICENSE_INSTALL_PATH=./
MLHUB_LICENSE_DOMAIN=mlhub.vn
MLHUB_LICENSE_TYPE=Extended License

# Email liên hệ site (Admin → Cài đặt) — thường trùng MLHUB_FIRST_USER_EMAIL
MLHUB_CONTACT_EMAIL=admin@mlhub.vn

# --- Livewire (cache-bust JS sau deploy lớn) ---
# Đổi chuỗi bất kỳ khi user báo 419 "page expired" sau nâng cấp; hoặc bảo họ Ctrl+F5
LIVEWIRE_RELEASE_TOKEN=2026-06-14-01

# --- Queue worker (Supervisor trong container) ---
# true = supervisord chạy queue:work. false nếu Coolify có service queue riêng (tránh 2 worker)
RUN_QUEUE_WORKER=true
# Phải là số dương và nhỏ hơn REDIS_QUEUE_RETRY_AFTER để job không chạy trùng.
QUEUE_WORKER_TIMEOUT=80

# --- Proxy / Demo ---
# * = tin mọi proxy (Coolify/Traefik) — HTTPS được nhận đúng trong bootstrap/app.php
TRUSTED_PROXIES=*
# false = production thật; true chỉ chặn ghi HTTP/Livewire (demo showcase)
APP_DEMO=false

# --- Ngôn ngữ & múi giờ ---
APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
# Locale Faker khi seed/test (địa chỉ VN)
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE=Asia/Ho_Chi_Minh

# --- Log & bảo mật ---
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# stack = Coolify stderr + file daily cho Admin Log; volume storage giữ log qua deploy
LOG_CHANNEL=stack
LOG_STACK=stderr,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- MySQL (Coolify service nội bộ) ---
DB_CONNECTION=mysql
# ⚠️ Hạ tầng riêng theo server — nên đặt trên Coolify. Giá trị thử nghiệm hiện tại:
DB_HOST=vdd0voqmyudditvwfhuscrta
DB_PORT=3306
DB_DATABASE=default
DB_USERNAME=mysql
DB_PASSWORD=FXlAITZo3hgZYZJ26pdHSn7e70Zm6EAh0uUTgNfUJgEScn6x24YiwAe9x89gmgIo
# Optional: ghi đè toàn bộ connection bằng URL (bỏ trống nếu dùng host/port/password riêng bên trên)
DB_URL=

# --- Session (Redis — bắt buộc production) ---
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_COOKIE=mlhub_session
SESSION_SECURE_COOKIE=true
# .mlhub.vn = cookie dùng chung mlhub.vn + www. Local dev: để trống
SESSION_DOMAIN=.mlhub.vn

# --- Queue & Cache (Redis) ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
CACHE_STORE=redis
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
# Nếu dùng REDIS_URL, URL chỉ dành cho queue/default; cấm query string và DB path mã hóa.
# Database path phải để trống hoặc đúng chính xác /0.
# App MLHUB → Environment Variables (tách host/user/password, KHÔNG commit PASSWORD):
REDIS_USERNAME=default
# ⚠️ Hạ tầng riêng theo server — nên đặt trên Coolify. Giá trị thử nghiệm hiện tại:
REDIS_HOST=w13teqa9fusj56ddpl8w8ezf
REDIS_PASSWORD=VJj4BYh0Oedesmer0LWeyeN8tfSQKuwBos9JfHamP375e9rAxYoWk40R4HLWPGlh
REDIS_PORT=6379
# Optional: ghi đè toàn bộ Redis connection bằng URL (bỏ trống nếu dùng host/port/password riêng bên trên)
REDIS_URL=
# Queue/default, cache/lock và session phải dùng ba DB khác nhau.
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_CACHE_LOCK_CONNECTION=cache
REDIS_QUEUE_RETRY_AFTER=90

# --- Mail SMTP (Emailit) ---
# MAIL_PASSWORD seed vào options.smtp_password khi chạy mlhub:install / db:seed
MAIL_MAILER=smtp
# tls/ssl = mã hóa SMTP (đồng bộ Admin → Mail Server). Laravel tự map sang DSN smtp/smtps.
MAIL_SCHEME=tls
MAIL_HOST=smtp.emailit.com
MAIL_PORT=587
MAIL_USERNAME=emailit
# Có DEFAULT trong env_options.php nên có thể bỏ khỏi Coolify (API key thử nghiệm):
MAIL_PASSWORD=secret_LHzlnBLwXz8ZGV0JztVkvn9mf4VFKE14
MAIL_FROM_ADDRESS=noreply@mlhub.vn
MAIL_FROM_NAME=${APP_NAME}
MAIL_EHLO_DOMAIN=mlhub.vn
# Optional: ghi đè toàn bộ mail config bằng DSN URL (bỏ trống nếu dùng host/port riêng bên trên)
MAIL_URL=

# --- Storage / File manager (module AppFiles) ---
# Disk dùng cho file manager portal/admin. public = mặc định (volume mlhub-storage).
# Đổi sang s3 / wasabi / contabo khi đã cấu hình credential bên dưới.
APP_FILES_DISK=public

# --- AWS S3 (tùy chọn — để trống = dùng disk public) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Wasabi S3 (tùy chọn — Admin có thể cấu hình storage sau) ---
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=
WASABI_DEFAULT_REGION=us-east-1
WASABI_BUCKET=
WASABI_URL=
WASABI_ENDPOINT=
WASABI_USE_PATH_STYLE_ENDPOINT=false

# --- Contabo Object Storage (tùy chọn — S3-compatible) ---
CONTABO_ACCESS_KEY_ID=
CONTABO_SECRET_ACCESS_KEY=
CONTABO_DEFAULT_REGION=eu-central-1
CONTABO_BUCKET=
CONTABO_URL=
CONTABO_ENDPOINT=
CONTABO_USE_PATH_STYLE_ENDPOINT=true

# --- Frontend build (Vite theme) ---
VITE_APP_NAME="${APP_NAME}"

# --- Site & theme MLHUB (seed → options + config/mlhub.php) ---
SITE_TITLE=MKT
SITE_DESCRIPTION=Nền tảng Marketing Automation hỗ trợ tăng đánh giá, đặt lịch, mã ưu đãi, phản hồi & tạo khách hàng tiềm năng.
SITE_KEYWORDS=MKT, Marketing Automation, đánh giá, đặt lịch, mã ưu đãi, phản hồi, khách hàng tiềm năng, hộ kinh doanh
THEME_FRONTEND=mlhubfrontend
THEME_BACKEND=mlhubbackend

# --- Admin Settings ↔ Coolify (đồng bộ vào options mỗi deploy / mlhub:install / mlhub:update) ---
# true = ghi env có giá trị vào Admin → Cài đặt (khuyến nghị production). false = chỉ seed thủ công.
# Map chi tiết: modules/CustomMLHUB/config/env_options.php — chạy: php artisan mlhub:sync-env-options
MLHUB_SYNC_ENV_OPTIONS=true
# Cron URL bảo mật — giữ cố định để link cron không đổi sau mlhub:install (sinh ngẫu nhiên nếu để trống lần đầu)
MLHUB_SYSTEM_CRON_SECURE_KEY=
# Liên hệ site (Admin → General)
MLHUB_CONTACT_PHONE=0899789225
MLHUB_CONTACT_WEBSITE=https://mlhub.vn
MLHUB_CONTACT_LOCATION=01 Nguyễn Văn Linh, Đà Nẵng
MLHUB_CONTACT_WORKING_HOURS=Thứ 2 - Thứ 6: 09:00 - 18:00

# --- Google OAuth: 2 BỘ KEY RIÊNG (KHÔNG dùng chung, KHÔNG copy lẫn nhau) ---
# Bộ 1 — Google đăng nhập (Admin → Authentication Rules → Google login)
#   Env: MLHUB_AUTH_GOOGLE_LOGIN_*
#   Callback: https://mlhub.vn/auth/login/google/callback
#   Scope: openid email profile
# Bộ 2 — Google Business Profile (Admin → API Integration → Google Business Profile)
#   Env: GOOGLE_BUSINESS_CLIENT_* + MLHUB_GOOGLE_BUSINESS_STATUS
#   Callback: https://mlhub.vn/portal/integrations/google-business/callback
#   Scope: https://www.googleapis.com/auth/business.manage
# Tạo 2 OAuth Client ID riêng trên Google Cloud Console, mỗi client chỉ 1 redirect URI tương ứng.

# --- Admin → Authentication Rules (/admin/settings/auth) ---
# 1 = bật | 0 = tắt. Nếu không đặt MLHUB_AUTH_*_LOGIN_STATUS mà đã có ID + Secret → tự bật khi sync.
MLHUB_AUTH_LANDING_PAGE_STATUS=1
MLHUB_AUTH_SIGNUP_PAGE_STATUS=1
MLHUB_AUTH_ACTIVATION_EMAIL_STATUS=1
MLHUB_AUTH_WELCOME_EMAIL_STATUS=1
MLHUB_AUTH_USER_CHANGE_EMAIL_STATUS=0
MLHUB_AUTH_USER_CHANGE_USERNAME_STATUS=0
MLHUB_AUTH_TWO_FACTOR_STATUS=1
# [Bộ 1] Google đăng nhập — KHÔNG trùng GOOGLE_BUSINESS_CLIENT_*
MLHUB_AUTH_GOOGLE_LOGIN_STATUS=1
# Có DEFAULT trong env_options.php nên có thể bỏ khỏi Coolify (giá trị thử nghiệm):
MLHUB_AUTH_GOOGLE_LOGIN_CLIENT_ID=577193085095-npcc1ilqv20dekqe08orcm3e6htao7tq.apps.googleusercontent.com
MLHUB_AUTH_GOOGLE_LOGIN_CLIENT_SECRET=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
# Facebook login — callback: https://mlhub.vn/auth/login/facebook/callback
MLHUB_AUTH_FACEBOOK_LOGIN_STATUS=0
MLHUB_AUTH_FACEBOOK_LOGIN_APP_ID=
MLHUB_AUTH_FACEBOOK_LOGIN_APP_SECRET=
MLHUB_AUTH_FACEBOOK_LOGIN_APP_VERSION=v22.0
# X (Twitter) login — callback: https://mlhub.vn/auth/login/x/callback
MLHUB_AUTH_X_LOGIN_STATUS=0
MLHUB_AUTH_X_LOGIN_CLIENT_ID=
MLHUB_AUTH_X_LOGIN_CLIENT_SECRET=

# --- Admin → Captcha (/admin/settings/captcha) ---
# Loại captcha: disable | turnstile | recaptcha
# Captcha có DEFAULT trong env_options.php nên có thể bỏ khỏi Coolify (giá trị thử nghiệm):
MLHUB_CAPTCHA_TYPE=turnstile
MLHUB_CLOUDFLARE_TURNSTILE_STATUS=1
MLHUB_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAADYVJ5pkiNy7poMX
MLHUB_CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAADYVJw4b7xm2WC3UNugtP1miHzw
MLHUB_GOOGLE_RECAPTCHA_STATUS=0
MLHUB_GOOGLE_RECAPTCHA_SITE_KEY=6LeeAAItAAAAABtl-viskX16U6_QbyjCXrz2v6HG
MLHUB_GOOGLE_RECAPTCHA_SECRET_KEY=6LeeAAItAAAAAM6gBf1GGNsO6wSA8OteZTG3ZHXV

# --- Admin → Analytics (/admin/settings/analytics) ---
MLHUB_GOOGLE_ANALYTICS_STATUS=1
MLHUB_GOOGLE_ANALYTICS_MEASUREMENT_ID=G-ZY1P6YJLME
MLHUB_GOOGLE_ANALYTICS_TRACK_GUEST=1
MLHUB_GOOGLE_ANALYTICS_TRACK_APP=1

# --- Admin → API Integration → Google Business Profile ---
# [Bộ 2] Google Business — KHÔNG trùng MLHUB_AUTH_GOOGLE_LOGIN_*
MLHUB_GOOGLE_BUSINESS_STATUS=1
# Có DEFAULT trong env_options.php nên có thể bỏ khỏi Coolify (giá trị thử nghiệm):
GOOGLE_BUSINESS_CLIENT_ID=577193085095-v34ha4i8peqqe3fo2gsd3crs2dldooct.apps.googleusercontent.com
GOOGLE_BUSINESS_CLIENT_SECRET=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
# Redirect URI OAuth Google Business — phải KHỚP Y HỆT URI đã đăng ký trong Google Cloud Console.
# Có thể để trống (code tự dùng route callback theo APP_URL), nhưng điền thẳng cho rõ ràng:
GOOGLE_BUSINESS_REDIRECT_URI=https://mlhub.vn/portal/integrations/google-business/callback

# --- Admin → Payment → Stripe (module PaymentStripe) ---
# Chỉ Stripe đọc credential từ env (seed vào options qua mlhub:sync-env-options).
STRIPE_STATUS=0
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Payment khác (PayPal / 2Checkout / thủ công) — KHÔNG cấu hình bằng env ---
# PaymentPaypal, Payment2Checkout và thanh toán thủ công lưu credential trong
# Admin → Settings → Payment Gateways (OptionStore: paypal_*, 2checkout_*, manual_*),
# KHÔNG đọc từ .env. Bật/tắt + nhập key ngay trong UI Admin.

# --- AI provider (laravel/ai + Prism) — KHÔNG cấu hình bằng env ---
# Key provider AI (OpenAI/Anthropic/Gemini…) lưu trong Admin → Settings → AI Config
# (OptionStore), KHÔNG đặt OPENAI_*/ANTHROPIC_* trong .env. Credit/giá: Admin → Plans.

# --- FizaHUB Partner API (module APIPartnerFizaHUB) ---
# Bearer token cho /api/v1/partners/fizahub/*. Giá trị này PHẢI khớp với biến collection
# `partner_token` trong FizaHUB-Partner-API.postman_collection.json đã gửi cho FizaHUB test —
# ĐẶT ĐÚNG GIÁ TRỊ NÀY trên Coolify (không dùng default 'fizahub' trong code nữa, vì nó không
# khớp file Postman đã gửi đối tác). ⚠️ Đổi sang token khác + cập nhật lại Postman trước khi
# chạy chính thức hoặc khi ngừng hợp tác với FizaHUB.
FIZAHUB_PARTNER_TOKEN=fizahub_6199e9a82d0e961002965d406c970efc0038d2a4e658c1cf
FIZAHUB_RATE_LIMIT_PER_MINUTE=60
FIZAHUB_ONE_TIME_LOGIN_TTL_MINUTES=15
# Gói mặc định khi provision tài khoản FizaHUB (map sang plan slug trong config).
FIZAHUB_DEFAULT_PACKAGE=free
# Ngôn ngữ thông báo API trả về app FizaHUB (insights / việc cần làm).
FIZAHUB_PARTNER_LOCALE=vi
# Email tạm khi trùng email chủ sở hữu (email nội bộ, không bao giờ gửi/nhận mail thật).
FIZAHUB_PROVISIONAL_EMAIL_DOMAIN=provisional.mlhub.vn
# Webhook callback về FizaHUB (onboarding-status/campaign-metrics/support-events).
# ⚠️ URL do FizaHUB cung cấp — ĐỂ TRỐNG là hợp lệ (webhook tự bỏ qua, KHÔNG lỗi).
# Khi test có thể tạm dùng https://webhook.site/<id> để soi payload.
FIZAHUB_WEBHOOK_BASE_URL=
# Khóa HMAC ký payload webhook — chia sẻ đúng giá trị này cho FizaHUB để họ verify chữ ký.
FIZAHUB_WEBHOOK_SECRET=600b3a729836b0461ea51c2067a1911acb83200e0b148404676f037e8556e56a
# Cache dashboard đối tác (phút) và cooldown khi ép làm mới (giây).
FIZAHUB_DASHBOARD_CACHE_TTL_MINUTES=45
FIZAHUB_DASHBOARD_FORCE_REFRESH_COOLDOWN_SECONDS=300
# Giới hạn tệp đính kèm phiếu hỗ trợ đối tác (MB).
FIZAHUB_SUPPORT_MAX_ATTACHMENT_SIZE_MB=10
# TTL (ngày) cho download_url + image_url ký tạm — nhấp link / mở ảnh không cần X-Partner/Bearer.
FIZAHUB_SUPPORT_IMAGE_PREVIEW_TTL_DAYS=7
# --- FizaHUB Partner Reporting Portal (cổng báo cáo view-only cho lãnh đạo FizaHUB) ---
# Domain riêng chạy cổng báo cáo (KHÁC domain mlhub.vn — phải trỏ DNS + thêm domain này
# trên Coolify cho ĐÚNG ứng dụng MLHUB hiện tại, không phải deploy service mới).
FIZAHUB_DOMAIN=fzh.vmo.com.vn
# Danh sách ID user MLHUB (users.id, cách nhau dấu phẩy) được phép đăng nhập xem cổng báo
# cáo trên FIZAHUB_DOMAIN. Chỉ cần đăng nhập bằng tài khoản MLHUB có sẵn đúng ID này.
# ⚠️ Đây là ID mẫu — ĐỔI thành ID thật của lãnh đạo FizaHUB trước khi dùng (Admin → Users).
# Để trống hoặc không có ID hợp lệ nào = KHÔNG ai truy cập được cổng báo cáo.
FIZAHUB_ADMIN=147123468,147123469
