{
    "name": "MLHUB Frontend",
    "description": "MLHUB marketing theme — fork of LocalBoostAI with MLHUB brand colors.",
    "version": "1.0.0",
    "order": 10,
    "author": "MLHUB",
    "tags": ["landing", "saas", "qr", "local-marketing", "light", "mlhub"],
    "supports": ["light-mode", "dark-mode", "theme-tokens"],
    "recommended_for": ["MLHUB marketing site", "pricing", "campaign landing pages"],
    "thumbnail": "preview.svg",
    "uses_flux": true,
    "settings": {
        "schema": {
            "accent_color": {
                "type": "color",
                "label": "Accent color",
                "default": "#ff5f5f"
            },
            "body_bg_color": {
                "type": "color",
                "label": "Body background",
                "default": "#fffbf8"
            },
            "surface_bg_color": {
                "type": "color",
                "label": "Surface background",
                "default": "#FFFFFF"
            },
            "header_bg_color": {
                "type": "color",
                "label": "Header background",
                "default": "#FFFFFF"
            },
            "header_text_color": {
                "type": "color",
                "label": "Header text color",
                "default": "#2d1810"
            },
            "link_color": {
                "type": "color",
                "label": "Link color",
                "default": "#ff5f5f"
            },
            "link_hover_color": {
                "type": "color",
                "label": "Link hover color",
                "default": "#ff8c42"
            },
            "border_color": {
                "type": "color",
                "label": "Border color",
                "default": "#ffe5dc"
            },
            "muted_text_color": {
                "type": "color",
                "label": "Muted text color",
                "default": "#8a7068"
            },
            "success_color": {
                "type": "color",
                "label": "Success color",
                "default": "#059669"
            },
            "warning_color": {
                "type": "color",
                "label": "Warning color",
                "default": "#ffb347"
            },
            "danger_color": {
                "type": "color",
                "label": "Danger color",
                "default": "#DC2626"
            },
            "font_family": {
                "type": "select",
                "label": "Font family",
                "default": "manrope",
                "options": {
                    "inter": "Inter",
                    "instrument-sans": "Instrument Sans",
                    "plus-jakarta-sans": "Plus Jakarta Sans",
                    "manrope": "Manrope",
                    "outfit": "Outfit",
                    "system": "System"
                }
            },
            "page_max_width": {
                "type": "select",
                "label": "Page max width",
                "default": "86rem",
                "options": {
                    "72rem": "Standard",
                    "80rem": "Wide",
                    "86rem": "Product",
                    "96rem": "Extra wide"
                }
            },
            "supports_dark_mode": {
                "type": "select",
                "label": "Dark mode support",
                "default": "1",
                "options": {
                    "0": "Disabled",
                    "1": "Enabled"
                }
            },
            "allow_user_appearance_toggle": {
                "type": "select",
                "label": "Appearance switcher",
                "default": "1",
                "options": {
                    "0": "Disabled",
                    "1": "Enabled"
                }
            },
            "default_appearance": {
                "type": "select",
                "label": "Default appearance",
                "default": "light",
                "options": {
                    "light": "Light",
                    "system": "System",
                    "dark": "Dark"
                }
            },
            "section_spacing": {
                "type": "select",
                "label": "Section spacing",
                "default": "5rem",
                "options": {
                    "4rem": "Compact",
                    "5rem": "Comfortable",
                    "6rem": "Spacious"
                }
            },
            "card_radius": {
                "type": "number",
                "label": "Card radius",
                "default": 18,
                "min": 0,
                "max": 28,
                "step": 1,
                "unit": "px"
            },
            "input_radius": {
                "type": "number",
                "label": "Input radius",
                "default": 14,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px"
            },
            "button_radius": {
                "type": "number",
                "label": "Button radius",
                "default": 14,
                "min": 0,
                "max": 24,
                "step": 1,
                "unit": "px"
            },
            "custom_css": {
                "type": "textarea",
                "label": "Custom CSS",
                "default": ""
            },
            "custom_js": {
                "type": "textarea",
                "label": "Custom JS",
                "default": ""
            }
        }
    }
}
